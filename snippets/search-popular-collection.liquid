<div class="searches-content">
    {% if settings.title != blank %}
        <h4>{{ settings.title }}</h4>
    {% endif %}
    <div class="popular-collections">
        {% for collection in settings.collection_list %}
        <div class="popular-item">
            <div class="popular__item-image">
            {% assign main_image = collection.featured_image | default: collection.image %}
            {% if main_image %}
                <picture>
                <source
                    media="(max-width: 600px)"
                    srcset="{{ main_image | image_url: width: 200 }}"
                >
                <source
                    media="(max-width: 1400px)"
                    srcset="{{ main_image | image_url: width: 250 }}"
                >
                
                {{ main_image | image_url: width: 300 | image_tag }}
                </picture>
            {% endif %}
            </div>
            <p>{{ collection.title }}</p>
            <a href="{{ collection.url }}"></a>
        </div>
        {% endfor %}
    </div>
</div>