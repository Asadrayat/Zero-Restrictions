{% liquid
  assign id = section.id
%}
{% assign page_handle = page.handle | downcase %}
<style>
  #shopify-section-{{id}} {
    box-sizing: border-box;
    margin-top: {{section.settings.margin_top | append: 'px'}};
    margin-bottom: {{section.settings.margin_bottom | append: 'px'}};
    padding-top: {{section.settings.padding_top | append: 'px'}};
    padding-bottom: {{section.settings.padding_bottom | append: 'px'}};
    background: #121212;
    {% if page_handle == 'about-us' %}
        display: none;
    {% endif %}
  }

  @media(max-width: 600px) {
    #shopify-section-{{id}} {
      margin-top: {{section.settings.margin_top_m | append: 'px'}};
      margin-bottom: {{section.settings.margin_bottom_m | append: 'px'}};
      padding-top: {{section.settings.padding_top_m | append: 'px'}};
      padding-bottom: {{section.settings.padding_bottom_m | append: 'px'}};
    }
  }
  .sec-{{ id }}{
    .video--wrapper {
        line-height: 0;
        aspect-ratio: 16/7;
        @media(max-width: 768px){
            aspect-ratio: unset;
        }
    }

    .content--wrapper{
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: var(--Spacing-Container-lg, 40px);
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        padding-bottom: var(--Spacing-Section-Section-Vertical-Padding, 48px);
        z-index: -1;
    }
    .content--wrapper .text--content{
        color: #FFF;
        text-align: center;

        /* Paragraph/XL */
        font-family: var(--font-family-Body, Archivo);
        font-size: var(--Font-Size-Paragraph-Large, 20px);
        font-style: normal;
        font-weight: 400;
        line-height: var(--Line-Height-Paragraph-Large, 30px); /* 150% */
        margin: 0;
        max-width: 734px;
        @media(max-width: 768px){
            font-size: var(--Font-Size-Paragraph-Medium, 16px);
            font-weight: 400;
            line-height: var(--Line-Height-Paragraph-Medium, 24px); /* 150% */
            max-width: 90%;
        }
    }
    .wrapper-{{ id }}{
        position: relative;
    }
    .__play__btn {
      align-items: center;
      /* background-color: #e5e5e5; */
      background-color: transparent;
      left: 50%;
      display: flex;
      height: 64px;
      justify-content: center;
      line-height: 1;
      position: absolute;
      top: 50%;
      width: 64px;
      z-index: 3;
      transform: translate(-50%, -50%);
      @media(max-width: 768px) {
        opacity: 0;
        z-index: -1;
      }
      svg {
        width: 64px;
        height: 64px;
      }      
    }
    .mute__btn {
      align-items: center;
      background-color: transparent;
      bottom: 3em;
      display: flex;
      height: 64px;
      justify-content: center;
      line-height: 1;
      position: absolute;
      right: 3em;
      width: 64px;
      border-radius: 999px;
      overflow: hidden;
      @media(max-width: 600px) {
        right: 2.4em;
        width: 48px;
        height: 48px;
        bottom: 3em;
      }
    }
    .content--wrapper .btn--content{
        display: flex;
        padding: 16px var(--Spacing-Container-lg, 40px);
        justify-content: center;
        align-items: center;
        gap: 8px;
        color: var(--Content-Inverted-main, #F3F4F6);
        text-align: center;
        font-family: var(--font-family-Body, Archivo);
        font-size: var(--Font-Size-UI-Controls-Control-Button-Regular, 16px);
        font-style: normal;
        font-weight: 400;
        line-height: var(--Line-Height-UI-Controls-Control-Button-Regular, 16px); /* 100% */
        text-transform: capitalize;
        margin: 0;
    }
    .video--wrapper .video-mobile {
      display: none;
    }
    
    .video--wrapper .video-desktop {
      display: block;
    }
    
    @media screen and (max-width: 767px) {
      .video--wrapper .video-mobile {
        display: block;
      }
      .video--wrapper.hide__desktop_video .video-desktop {
        display: none;
      }
    }   
    .video--wrapper video{
        width: 100%;
        height: 100%;
        object-fit: cover;
        line-height: 0;
    }             
  }
</style>

<div class="sec-{{ id }}">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    <div class="wrapper-{{ id }}" data-video-frame>
      {% if section.settings.video or section.settings.video_m %}
        <div class="video--wrapper {% if section.settings.video_m %}hide__desktop_video{% endif %} " data-video-container>

        </div>
      {% endif %}
      <div class="content--wrapper">
        {% if section.settings.text %}
          <p class="text--content">{{ section.settings.text }}</p>
        {% endif %}
        {% if section.settings.btn %}
          <a href="{{ section.settings.link }}" class="btn--content">{{ section.settings.btn }}</a>
        {% endif %}
      </div>
      {% comment %} <div class="mute__btn ">{% render 'all-icons', name: 'mute_btn' %}</div>       {% endcomment %}
       <div class="__play__btn hidden">{% render 'all-icons', name: 'play-btn' %}</div>
    </div>
  </div>
</div>


<script type="application/json" data-video-data>
{
  "desktop": {% if section.settings.video %}{{ section.settings.video | json }}{% else %}null{% endif %},
  "mobile": {% if section.settings.video_m %}{{ section.settings.video_m | json }}{% else %}null{% endif %}
}
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    let hasAppendedVideos = false;
    
    function videoFunctionality () {
      const videoFrame = document.querySelector('[data-video-frame]');
      if (!videoFrame) return;
      
      const vfVideos = videoFrame.querySelectorAll('video');
      
      function getVisibleVideo() {
        let visibleVideo = null;
        vfVideos.forEach((video) => {
          const isVisible = window.getComputedStyle(video).display !== 'none';
          if (isVisible) {
            visibleVideo = video;
          }
        });
        return visibleVideo;
      }
      
      vfVideos.forEach((vfVideo) => {
        vfVideo.muted = true;
        vfVideo.volume = 1;
      });
      
      function manageVideoPlayback() {
        vfVideos.forEach((video) => {
          const isVisible = window.getComputedStyle(video).display !== 'none';
          if (!isVisible && !video.paused) {
            video.pause();
          }
        });
      }
      
      manageVideoPlayback();
      window.addEventListener('resize', manageVideoPlayback);
      
      const muteBtns = videoFrame.querySelectorAll('.mute__btn');
      const playBtns = videoFrame.querySelectorAll('.__play__btn');

      function updatePlayButtonVisibility(video) {
        if (!video) return;
        
        if (video.paused) {
          playBtns.forEach((playBtn) => {
            playBtn.classList.remove('hidden');
          });
        } else {
          playBtns.forEach((playBtn) => {
            playBtn.classList.add('hidden');
          });
        }
      }

      videoFrame.addEventListener('click', (e) => {
        const visibleVideo = getVisibleVideo();
        if (!visibleVideo) return;
        
        videoFrame.classList.add('active');
        
        if(muteBtns) {
          muteBtns.forEach((mutedBtn) => {
            mutedBtn.classList.add('hidden');
          });
        }

        visibleVideo.controls = true;
        visibleVideo.muted = false;
        visibleVideo.removeAttribute('muted');
        visibleVideo.volume = 1;
        visibleVideo.parentElement.classList.add('active');

        updatePlayButtonVisibility(visibleVideo);

        visibleVideo.addEventListener('play', () => {
          updatePlayButtonVisibility(visibleVideo);
        });

        visibleVideo.addEventListener('pause', () => {
          updatePlayButtonVisibility(visibleVideo);
        });
      });
    }
    
    const appendVideos = () => {
      if (hasAppendedVideos) return;
      
      const videoContainer = document.querySelector('[data-video-container]');
      const videoDataElement = document.querySelector('[data-video-data]');
      
      if (!videoContainer || !videoDataElement) return;
      
      try {
        const videoData = JSON.parse(videoDataElement.textContent);
        console.log("Test", videoData);
        
        // Determine which video to use based on screen size
        const isMobile = window.innerWidth <= 768;
        const selectedVideo = isMobile && videoData.mobile && videoData.mobile.sources 
          ? videoData.mobile 
          : videoData.desktop;
        
        // Create and append the appropriate video
        if (selectedVideo && selectedVideo.sources) {
          const video = document.createElement('video');
          video.className = isMobile ? 'video-mobile' : 'video-desktop';
          video.setAttribute('playsinline', '');
          video.setAttribute('loop', '');
          video.setAttribute('autoplay', '');
          video.muted = true;
          
          selectedVideo.sources.forEach(source => {
            const sourceEl = document.createElement('source');
            sourceEl.src = source.url;
            sourceEl.type = source.mime_type;
            video.appendChild(sourceEl);
          });
          
          videoContainer.appendChild(video);
          hasAppendedVideos = true;
          
          // Initialize video functionality after video is appended
          videoFunctionality();
        }
        
      } catch (error) {
        console.error('Error appending videos:', error);
      }
    };
    
    // Append videos immediately on DOMContentLoaded
    appendVideos();
    
    // Fallback: append on scroll if not already done
    window.addEventListener('scroll', () => {
      if (!hasAppendedVideos) {
        appendVideos();
      }
    }, { once: true });
  }); 
</script>

