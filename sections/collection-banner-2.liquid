{% liquid
  assign id = section.id
  assign has_image = false
  if collection.image or collection.featured_image or section.settings.image
    assign has_image = true
  endif
%}

<style>
   #shopify-section-{{id}} {
     box-sizing: border-box;
     margin-top: {{section.settings.margin_top | append: 'px'}};
     margin-bottom: {{section.settings.margin_bottom | append: 'px'}};
     padding-top: {{section.settings.padding_top | append: 'px'}};
     padding-bottom: {{section.settings.padding_bottom | append: 'px'}};
     position: relative;
   }
   {% comment %}
   #shopify-section-{{id}}:after{
     content: '';
     position: absolute;
     top: 0;
     left: 0;
     width: 100%;
     height: 100%;
     background-color: rgba(0,0,0,0.4);
   }
   {% endcomment %}
   @media(max-width: 768px) {
     #shopify-section-{{id}} {
       margin-top: {{section.settings.margin_top_m | append: 'px'}};
       margin-bottom: {{section.settings.margin_bottom_m | append: 'px'}};
       padding-top: {{section.settings.padding_top_m | append: 'px'}};
       padding-bottom: {{section.settings.padding_bottom_m | append: 'px'}};
     }
   }
   #shopify-section-{{id}} .page-width{

     /* max-width: 100%;
     @media(max-width: 1700px){
       padding-inline: 20px;
     } */
   }
   .wrapper-{{ id }}{
     position: relative;
   }
   
   .wrapper-{{ id }}.has-image{
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
   }
   
   @media(max-width: 768px) {
     .wrapper-{{ id }}.has-image{
       grid-template-columns: 1fr;
       gap: 0;
     }
   }
   
   .img-wrapper-{{ id }} img{
     display: block;
     width: 100%;
     height: 100%;
     max-height: 500px;
     object-fit: cover;
   }
   
   .content-wrapper-{{ id }}{
     position: relative;
   }
   
   {% comment %}
   .contents-{{ id }}{
     position: absolute;
     top: 50%;
     left: 50%;
     transform: translate(-50%,-50%);
     text-align: center;
     z-index: 1;
     @media(max-width: 768px) {
       width: 100%;
     }
   }

   .contents-{{ id }} *{
     color: {{ section.settings.color }};
   }
   {% endcomment %}

    .content-wrapper-{{ id }}{

      {% if has_image %}
        background: #121212;
        display: flex;
        {% comment %} align-items: center; {% endcomment %}
        justify-content: center;
        flex-direction: column;
        padding: 25px;
      {% endif %}
      @media screen and (max-width: 768px){
        {% if has_image %}
          padding: 15px;
        {% endif %}
      }
    }

    {% if has_image %}
      .content-wrapper-{{ id }} *{
        color: #FFF !important;
      }
    {% endif %}

   .contents-{{ id }}  {
     @media(min-width: 768px){
       max-width: 60%;
     }

   }
   .contents-{{ id }} h1{
     font-family: var(--font-family-Body);
     {% comment %} font-size: 24px;
     line-height: 1.2; {% endcomment %}
     font-size: var(--Font-Size-Heading-H3);
    line-height: var(--Line-Height-Heading-H3);
     margin: 0 0 8px;
   }
   .contents-{{ id }} p{
     font-family: var(--font-family-Body);
     font-size: 16px;
     line-height: 24px;
     margin: 0;
   }




  .collections__list{
     display: flex;
     flex-wrap: wrap;
     align-items: center;
     /* justify-content: center; */
     gap: 12px;
     overflow-x: auto;
     scrollbar-width: thin;
     padding: 0;
     margin-block: 16px;
     @media(max-width: 1050px) {
       /* justify-content: start; */
       scrollbar-width: none; /* Firefox */
     -ms-overflow-style: none;  /* Internet Explorer 10+ */
       padding-block: 10px;
     }
   }

   .collections__list  a{
      display: inline-block; 
      padding: 8px 16px;
      min-width: max-content;
      border-radius: var(--rounded-full, 999999px);
      border: 1px solid var(--Border-Base-main, #D1D5DB);
      display: inline-block;
      font-family: var(--font-family-Body);
      font-size: var(--Font-Size-Paragraph-Tiny);
      text-align: center;
      {% if has_image %}
      background: transparent;
      {% else %}
      background: rgba(255, 255, 255, 0.40);
      {% endif %}
      color: rgba(121,121,121,var(--tw-text-opacity,1));
   }

   .collections__list  a:hover{
     color: #000;
   }

   .collections__list  a.active{
     color: #000;
     border: 1px solid #000;
   }
   {% if has_image %}
    .has-image .collections__list  a.active{
      background: #FFF;
      border-color: #FFF;
      color: #121212 !important;
    }
   {% endif %}
   @media screen and (max-width: 744px){
     .collections__list{
       gap: 8px;
     }
   }
   @media screen and (max-width: 768px){
     #shopify-section-{{id}} .page-width{
       padding-inline: 10px;
     }
     .contents-{{ id }} h1{
     }
   }
</style>

<div class="sec-{{ id }}">
  <div class="{% unless has_image %}page-width{% endunless %}">
    <div class="wrapper-{{ id }} {% if has_image %}has-image{% endif %}">
      
        <div class="img-wrapper-{{ id }}">
          {% if collection.image %}
            {{ collection.image | image_url: width: collection.image.width | image_tag }}
          {% elsif collection.featured_image %}
            {{ collection.featured_image | image_url: width: collection.featured_image.width | image_tag }}
          {% elsif section.settings.image %}
            {{ section.settings.image | image_url: width: section.settings.image.width | image_tag }}
          {% endif %}
        </div>
      
      <div class="content-wrapper-{{ id }}">
        <div class="contents-{{ id }}">
          <h1>{{ collection.title }} </h1>
          {% if collection.description != blank %}
            <p>{{ collection.description }}</p>
          {% endif %}
        </div>

        {% if collection.metafields.custom.related_collection.value != blank %}
          <div class="collections__list">
            {% for xcollection in collection.metafields.custom.related_collection.value %}
                <a href="{{ xcollection.url }}" class="{% if xcollection.url == collection.url %}active{% endif %}">
                  {{ xcollection.title }}
                </a>
            {% endfor %}
          </div>
         
        {% elsif collection.metafields.custom.fallback_collection != blank %}
          <div class="collections__list">
            {% for xcollection in collection.metafields.custom.fallback_collection.value.metafields.custom.related_collection.value %}
                <a href="{{ xcollection.url }}" class="{% if xcollection.url == collection.url %}active{% endif %}">
                  {{ xcollection.title }}
                </a>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection Banner 2",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width Section",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Texts Color",
      "default": "#FFF"
    },
    {
      "type": "header",
      "content": "Section Spacing Desktop"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Margin Top",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Margin Bottom",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section Spacing Mobile"
    },
    {
      "type": "range",
      "id": "margin_top_m",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Margin Top",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin_bottom_m",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Margin Bottom",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_m",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_m",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],

  "presets": [
    {
      "name": "Collection Banner 2"
    }
  ]
}
{% endschema %}